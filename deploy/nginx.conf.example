# Include this server block in Nginx's http context.
# Replace backend.internal:8000 with the backend address reachable from Nginx.
# Copy web/index.html, web/styles.css and web/app.js into the root directory.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /api {
        return 308 /api/;
    }

    location /api/ {
        # The trailing slash strips /api/: /api/user/login -> /user/login.
        proxy_pass http://backend.internal:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

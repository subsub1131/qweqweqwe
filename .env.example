# Copy values into your existing configuration; never commit real secrets.
DATABASE_URL=sqlite:///./app.db
# Required for login: generate a NEW random secret with at least 32 UTF-8 bytes.
# Generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty keys and the previous built-in default cannot sign sessions.
SECRET_KEY=
ALGORITHM=HS256
FRONTEND_URL=http://127.0.0.1:8080
# Use true for HTTPS production; false only for local HTTP.
COOKIE_SECURE=false
# Kakao requires the REST key and redirect URI; Client Secret is optional.
# Register the exact externally reachable callback URL in the Kakao console.
# Local reverse-proxy example: http://127.0.0.1:8000/api/auth/kakao/callback
# Provider readiness also requires valid FRONTEND_URL and SECRET_KEY settings.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# PortOne V2: use TEST channel only. API and webhook secrets stay on server.
PORTONE_ENABLED=false
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_ORDER_FILE=data/portone-orders.json
